BASE_URL=http://localhost:3000

# Servidor de roteirização (OSRM) usado para traçar o caminho mais rápido no mapa.
# Em produção, aponte para o OSRM interno.
OSRM_BASE_URL=https://router.project-osrm.org

# Webapp estático de navegação/acompanhamento. Em emulador Android use 10.0.2.2.
TRIP_WEBAPP_URL=http://localhost:3001

# Canal de tempo real e endpoints de tracking. Nunca inclua token nestas URLs.
TRIP_SOCKET_URL=http://localhost:3000
TRIP_TRACKING_BASE_URL=http://localhost:3000/corridas

# Enquanto o backend de tracking não estiver disponível, mantém o fluxo testável.
TRIP_TRACKING_MOCK=false

# Passageiro: afastamento sustentado antes do alerta.